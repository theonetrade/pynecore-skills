//@version=6
// Pine-first template: edit this file in content/, never the generated scripts/<name>.py.
// Every top-level input becomes a main() parameter of the Pyne script; the strategy()
// arguments become the @script.strategy(...) decorator; `var` becomes Persistent state.
strategy("EMA cross with ATR exits", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.05)

// Inputs: a default here is used until scripts/<name>.toml sets `value =` for it
fastLen   = input.int(12, "Fast EMA", minval=1)
slowLen   = input.int(21, "Slow EMA", minval=2)
atrLen    = input.int(14, "ATR length", minval=1)
stopMult  = input.float(2.0, "Stop ATR multiple", minval=0.1, step=0.1)
tpMult    = input.float(3.0, "Target ATR multiple", minval=0.1, step=0.1)
useFilter = input.bool(true, "Only above 200 EMA")

// Indicators: call ta.* on every bar, at the top level, so their history is complete
fast  = ta.ema(close, fastLen)
slow  = ta.ema(close, slowLen)
trend = ta.ema(close, 200)
atr   = ta.atr(atrLen)

longSignal = ta.crossover(fast, slow) and (not useFilter or close > trend)
exitSignal = ta.crossunder(fast, slow)

// State kept across bars
var float stopPrice   = na
var float targetPrice = na

if longSignal and strategy.position_size == 0
    stopPrice   := close - stopMult * atr
    targetPrice := close + tpMult * atr
    strategy.entry("L", strategy.long)
    strategy.exit("L exit", "L", stop=stopPrice, limit=targetPrice)

if exitSignal and strategy.position_size > 0
    strategy.close("L", comment="cross down")

// Plots: each title becomes a column of output/<name>.csv
plot(fast, "Fast EMA", color=color.teal)
plot(slow, "Slow EMA", color=color.orange)
plot(strategy.position_size > 0 ? stopPrice : na, "Stop", color=color.red, style=plot.style_linebr)
plot(strategy.position_size > 0 ? targetPrice : na, "Target", color=color.green, style=plot.style_linebr)
